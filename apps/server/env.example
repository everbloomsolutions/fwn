# Backend Environment Variables
# 
# NOTE: This file is optional. Backend will read from root .env first.
# Use this file only if you need backend-specific overrides.
# 
# See ../env.example for the main configuration file.
#
# Server Configuration
# NODE_ENV=development
# BACKEND_PORT=8080
# BACKEND_HOST=localhost
#
# Database Configuration
# DATABASE_URL=postgresql://user:password@localhost:5432/dbname
# Or for MongoDB:
#
# For MongoDB Atlas (cloud - recommended for Vercel):
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/dbname?retryWrites=true&w=majority
# - Automatically enables TLS/SSL
# - Works out of the box with Vercel
# - No IP whitelisting needed if using 0.0.0.0/0 (less secure) or Vercel IPs
#
# For self-hosted MongoDB (local or remote server):
# MONGODB_URI=mongodb://username:password@host:27017/dbname
# - For Vercel: Use public IP or domain name (not localhost)
# - For Vercel: Ensure MongoDB is accessible from internet (firewall rules)
# - For Vercel: Consider using MongoDB Atlas or VPN for security
# - TLS disabled by default unless MONGODB_TLS=true
#
# For self-hosted MongoDB with TLS:
# MONGODB_URI=mongodb://username:password@host:27017/dbname?tls=true
# OR set MONGODB_TLS=true
#
# Local development (localhost):
# MONGODB_URI=mongodb://localhost:27017/dbname
# MONGODB_URI=mongodb://127.0.0.1:27017/dbname

# Mongoose-specific options (set globally, not passed to MongoDB driver)
# Disable command buffering for serverless environments (recommended: false)
# MONGOOSE_BUFFER_COMMANDS=false
# Maximum number of operations to buffer when disconnected (0 = disable buffering)
# MONGOOSE_BUFFER_MAX_ENTRIES=0
# Enable strict query mode (recommended: true)
# MONGOOSE_STRICT_QUERY=true
# Enable strict populate mode (recommended: true)
# MONGOOSE_STRICT_POPULATE=true

# MongoDB driver connection options (passed to mongoose.connect())
# Server selection timeout in milliseconds
# MONGODB_SERVER_SELECTION_TIMEOUT_MS=10000
# Socket timeout in milliseconds
# MONGODB_SOCKET_TIMEOUT_MS=45000
# Connection timeout in milliseconds
# MONGODB_CONNECT_TIMEOUT_MS=10000
# Maximum connection pool size
# MONGODB_MAX_POOL_SIZE=10
# Minimum connection pool size
# MONGODB_MIN_POOL_SIZE=2
# Enable retry writes (recommended: true)
# MONGODB_RETRY_WRITES=true
# Enable retry reads (recommended: true)
# MONGODB_RETRY_READS=true
# Heartbeat frequency in milliseconds
# MONGODB_HEARTBEAT_FREQUENCY_MS=10000
# Compression algorithms (comma-separated: zlib,snappy,zstd)
# MONGODB_COMPRESSORS=zlib

# TLS/SSL Configuration
# For MongoDB Atlas (mongodb+srv://): TLS is automatically enabled, no configuration needed
# For self-hosted MongoDB: TLS disabled by default unless explicitly enabled
#
# Enable TLS for self-hosted MongoDB (default: false for mongodb://, true for mongodb+srv://)
# MONGODB_TLS=true
#
# Allow invalid certificates (NOT recommended for production, default: false)
# Only use for development with self-signed certificates
# MONGODB_TLS_ALLOW_INVALID_CERTS=false
#
# Note: If TLS options are already in the connection string (e.g., ?tls=true),
# those will take precedence over these environment variables
#
# JWT Configuration
# JWT_SECRET=your-secret-key-here
# JWT_EXPIRES_IN=7d
# JWT_REFRESH_EXPIRES_IN=30d
#
# CORS Configuration
# BACKEND_CORS_ORIGIN=http://localhost:5000
# For production (comma-separated for multiple origins):
# BACKEND_CORS_ORIGIN=https://foodworldnaturals.com,https://www.foodworldnaturals.com

# Backend URL Configuration (for OAuth callbacks and API endpoints)
# For Vercel with custom domain (api.foodworldnaturals.com):
# BACKEND_URL=https://api.foodworldnaturals.com
# For local development:
# BACKEND_URL=http://localhost:8080
# Note: If not set, will be constructed from BACKEND_HOST and BACKEND_PORT

# Frontend URL (required in production)
# FRONTEND_URL=https://foodworldnaturals.com
# For local development:
# FRONTEND_URL=http://localhost:5000

# Brand Configuration (optional - defaults provided)
# BRAND_NAME=Foodworld Naturals
# BRAND_TAGLINE=Turnkey Electrical Works| H.T.,L.T. Installation | Solar PV Projects | New Site Setup | Panel Installations
# BRAND_DESCRIPTION=Foodworld Naturals – Providing dependable, efficient, and safe electrical and technology solutions across South India
# BRAND_CONTACT_EMAIL=info@foodworldnaturals.com
# BRAND_SUPPORT_EMAIL=info@foodworldnaturals.com
# BRAND_WEBSITE_URL=https://foodworldnaturals.com
# BRAND_TWITTER_HANDLE=@foodworldnaturals
# BRAND_TWITTER_URL=https://twitter.com/foodworldnaturals

# API Configuration (optional)
# API_NAME=Foodworld Naturals API
# API_VERSION=1.0.0
# API_DESCRIPTION=Foodworld Naturals API - Electrical contracting and technology solutions backend

# Razorpay (optional - payment integration)
# RAZORPAY_KEY_ID=your-razorpay-key-id
# RAZORPAY_KEY_SECRET=your-razorpay-key-secret

# Logging
# LOG_LEVEL=info


# Email Configuration (SMTP)
# For Gmail: Use App Password (not regular password)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# SMTP_FROM=noreply@yourdomain.com
# ADMIN_EMAIL=your-personal-email@example.com  # Email address to receive inquiry notifications

# For other providers:
# - Outlook/Hotmail: smtp-mail.outlook.com:587
# - Yahoo: smtp.mail.yahoo.com:587
# - SendGrid: smtp.sendgrid.net:587 (use API key as password)
# - Mailgun: smtp.mailgun.org:587
